<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Keychain Sharing -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.ios.template</string>
        <string>$(AppIdentifierPrefix)com.ios.template.shared</string>
    </array>
    
    <!-- App Groups (for sharing data between app and extensions) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.ios.template</string>
    </array>
    
    <!-- Associated Domains (for Universal Links, App Site Association) -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:yourapp.com</string>
        <string>applinks:www.yourapp.com</string>
        <string>webcredentials:yourapp.com</string>
    </array>
    
    <!-- Push Notifications -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- For production, change to: <string>production</string> -->
    
    <!-- Background Modes -->
    <key>com.apple.developer.background-modes</key>
    <array>
        <string>background-fetch</string>
        <string>background-processing</string>
        <string>remote-notification</string>
    </array>
    
