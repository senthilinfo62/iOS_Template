# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  before_all do
    # Auto-sync team ID from Xcode project before any lane
    begin
      UI.message("🔄 Auto-syncing team ID from Xcode project...")

      # Ensure script is executable
      sh("chmod +x ../scripts/sync_team_id.sh") if File.exist?("../scripts/sync_team_id.sh")

      # Run the sync script
      sh("../scripts/sync_team_id.sh")

    rescue => ex
      UI.important("⚠️ Team ID sync failed: #{ex}")
      UI.important("Continuing with existing Appfile configuration...")
    end

    setup_circle_ci if ENV['CI']
  end

  desc "Build and upload staging build to TestFlight"
  lane :staging do
    begin
      # Sync certificates and provisioning profiles
      match(
        type: "appstore",
        app_identifier: "com.nexware.template.stg",
        readonly: true
      )

      # Increment build number
      increment_build_number(
        xcodeproj: "template.xcodeproj"
      )

      # Build the app for iOS device (required for TestFlight)
      build_app(
        scheme: "template",
        configuration: "Debug",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            "com.ios.template.stg" => "match AppStore com.ios.template.stg"
          }
        },
        xcargs: "PRODUCT_BUNDLE_IDENTIFIER=com.nexware.template.stg"
      )

      # Upload to TestFlight
      upload_to_testflight(
        app_identifier: "com.nexware.template.stg",
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        distribute_external: false,
        notify_external_testers: false,
        changelog: "Staging build from CI/CD pipeline"
      )

      UI.success("✅ Staging build uploaded to TestFlight!")

    rescue => ex
      UI.important("⚠️ Staging build failed: #{ex}")
      UI.important("If certificates are not configured, this is expected")
      UI.important("Run './scripts/setup_certificates.sh' to configure certificates")

      # Fallback: Build for simulator only (for template testing)
      UI.important("🔄 Falling back to simulator build for testing...")
      xcodebuild(
        scheme: "template",
        configuration: "Debug",
        destination: "generic/platform=iOS Simulator",
        xcargs: "PRODUCT_BUNDLE_IDENTIFIER=com.nexware.template.stg CODE_SIGNING_ALLOWED=NO",
        build: true
      )
      UI.success("✅ Simulator build completed")
    end
  end

  desc "Build and upload production build to TestFlight"
  lane :production do
    begin
      # Sync certificates and provisioning profiles
      match(
        type: "appstore",
        app_identifier: "com.nexware.template",
        readonly: true
      )

      # Increment build number
      increment_build_number(
        xcodeproj: "template.xcodeproj"
      )

      # Build the app for iOS device (required for TestFlight)
      build_app(
        scheme: "template",
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            "com.ios.template" => "match AppStore com.ios.template"
          }
        },
        xcargs: "PRODUCT_BUNDLE_IDENTIFIER=com.nexware.template"
      )

      # Upload to TestFlight
      upload_to_testflight(
        app_identifier: "com.nexware.template",
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        distribute_external: false,
        notify_external_testers: false,
        changelog: "Production build from CI/CD pipeline"
      )

      UI.success("✅ Production build uploaded to TestFlight!")

    rescue => ex
      UI.important("⚠️ Production build failed: #{ex}")
      UI.important("If certificates are not configured, this is expected")
      UI.important("Run './scripts/setup_certificates.sh' to configure certificates")

      # Fallback: Build for simulator only (for template testing)
      UI.important("🔄 Falling back to simulator build for testing...")
      xcodebuild(
        scheme: "template",
        configuration: "Release",
        destination: "generic/platform=iOS Simulator",
        xcargs: "PRODUCT_BUNDLE_IDENTIFIER=com.nexware.template CODE_SIGNING_ALLOWED=NO",
        build: true
      )
      UI.success("✅ Simulator build completed")
    end
  end

  desc "Download certificates and provisioning profiles"
  lane :certificates do
    begin
      match(
        type: "appstore",
        app_identifier: ["com.nexware.template", "com.nexware.template.stg"],
        readonly: true
      )
    rescue => ex
      UI.important("⚠️ Certificate setup failed: #{ex}")
      UI.important("This is expected for a template project without configured certificates")
      UI.important("Configure match and certificates for your specific app")
    end
  end

  desc "Run tests"
  lane :test do
    begin
      run_tests(
        scheme: "template",
        devices: ["iPhone 16"],
        code_coverage: true
      )
    rescue => ex
      UI.important("⚠️ Tests failed or no test targets found: #{ex}")
      UI.important("This is expected for a template project without configured test targets")
      UI.important("Add test targets to your project for proper testing")
    end
  end

  desc "Sync team ID from Xcode project to Appfile"
  lane :sync_team do
    begin
      UI.message("🔍 Syncing team ID from Xcode project...")
      sh("../scripts/sync_team_id.sh")
      UI.success("✅ Team ID synced successfully!")
    rescue => ex
      UI.error("❌ Failed to sync team ID: #{ex}")
    end
  end

  error do |lane, exception|
    if ENV['SLACK_URL'] && !ENV['SLACK_URL'].empty? && ENV['SLACK_URL'].start_with?('https://')
      slack(
        message: "❌ Lane #{lane} failed with error: #{exception.message}",
        success: false
      )
    else
      UI.important("⚠️ Slack notification skipped - SLACK_URL not configured or invalid")
    end
  end
end
