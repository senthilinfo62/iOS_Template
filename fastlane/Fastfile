# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  before_all do
    setup_circle_ci if ENV['CI']
  end

  desc "Build and upload staging build to TestFlight"
  lane :staging do
    begin
      # Increment build number
      increment_build_number(
        xcodeproj: "template.xcodeproj"
      )

      # Build the app for iOS Simulator
      xcodebuild(
        scheme: "template",
        configuration: "Debug",
        destination: "platform=iOS Simulator,name=iPhone 16",
        xcargs: "PRODUCT_BUNDLE_IDENTIFIER=com.ios.template.stg CODE_SIGNING_ALLOWED=NO",
        build: true
      )

      UI.success("✅ Staging build completed")
      UI.important("⚠️ TestFlight upload skipped - configure certificates for your app")

    rescue => ex
      UI.important("⚠️ Staging build failed: #{ex}")
      UI.important("This is expected for a template project without configured certificates")
    end
  end

  desc "Build and upload production build to TestFlight"
  lane :production do
    begin
      # Increment build number
      increment_build_number(
        xcodeproj: "template.xcodeproj"
      )

      # Build the app for iOS Simulator
      xcodebuild(
        scheme: "template",
        configuration: "Release",
        destination: "platform=iOS Simulator,name=iPhone 16",
        xcargs: "PRODUCT_BUNDLE_IDENTIFIER=com.ios.template CODE_SIGNING_ALLOWED=NO",
        build: true
      )

      UI.success("✅ Production build completed")
      UI.important("⚠️ TestFlight upload skipped - configure certificates for your app")

    rescue => ex
      UI.important("⚠️ Production build failed: #{ex}")
      UI.important("This is expected for a template project without configured certificates")
    end
  end

  desc "Download certificates and provisioning profiles"
  lane :certificates do
    begin
      match(
        type: "appstore",
        app_identifier: ["com.ios.template", "com.ios.template.stg"],
        readonly: true
      )
    rescue => ex
      UI.important("⚠️ Certificate setup failed: #{ex}")
      UI.important("This is expected for a template project without configured certificates")
      UI.important("Configure match and certificates for your specific app")
    end
  end

  desc "Run tests"
  lane :test do
    begin
      run_tests(
        scheme: "template",
        devices: ["iPhone 16"],
        code_coverage: true
      )
    rescue => ex
      UI.important("⚠️ Tests failed or no test targets found: #{ex}")
      UI.important("This is expected for a template project without configured test targets")
      UI.important("Add test targets to your project for proper testing")
    end
  end

  error do |lane, exception|
    slack(
      message: "❌ Lane #{lane} failed with error: #{exception.message}",
      success: false
    ) if ENV['SLACK_URL']
  end
end
